{
  "name": "@spotless/render",
  "version": "0.1.0",
  "private": true,
  "description": "Three.js scene builder shared by the web client and the headless render service",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@spotless/catalogue": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/machine": "workspace:*",
    "pngjs": "7.0.0",
    "puppeteer-core": "24.43.1",
    "three": "0.186.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0"
  }
}
