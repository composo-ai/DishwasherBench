{
  "name": "@spotless/wash-runner",
  "version": "0.1.0",
  "private": true,
  "description": "The real wash inside the game: from the session's load manifest to the simulation's input, the wash at a tier, and the wash report with residue maps",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "measure": "tsx scripts/measure.ts",
    "repro": "tsx scripts/repro.ts",
    "wash-load": "tsx scripts/wash-load.ts"
  },
  "dependencies": {
    "@spotless/catalogue": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/levels": "workspace:*",
    "@spotless/machine": "workspace:*",
    "@spotless/session": "workspace:*",
    "@spotless/sim-core": "workspace:*",
    "@spotless/sim-gpu": "workspace:*"
  },
  "devDependencies": {
    "@spotless/loader": "workspace:*"
  }
}
