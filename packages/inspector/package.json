{
  "name": "@spotless/inspector",
  "version": "0.1.0",
  "private": true,
  "description": "End-of-cycle evaluation: per-item speck count, soiled area, score and retained water",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@spotless/catalogue": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/machine": "workspace:*",
    "@spotless/sim-params": "workspace:*"
  }
}
