{
  "name": "@spotless/bench",
  "version": "0.1.0",
  "private": true,
  "description": "The benchmark harness: runs episodes of scripted policies and models through the MCP tools, verifies them by replay, writes episode records and the results table",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx src/cli.ts",
    "reference-table": "tsx scripts/reference-table.ts",
    "course-table": "tsx scripts/course-table.ts",
    "mistake-study": "tsx scripts/mistake-study.ts",
    "robustness": "tsx scripts/robustness.ts",
    "soil-lab": "tsx scripts/soil-lab.ts",
    "episode-cost": "tsx scripts/episode-cost.ts",
    "measure-episode": "tsx scripts/measure-episode.ts",
    "episode-table": "tsx scripts/episode-table.ts"
  },
  "bin": {
    "spotless-bench": "./src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@spotless/core": "workspace:*",
    "@spotless/levels": "workspace:*",
    "@spotless/loader": "workspace:*",
    "@spotless/mcp": "workspace:*",
    "@spotless/server": "workspace:*",
    "@spotless/session": "workspace:*",
    "@spotless/wash-runner": "workspace:*"
  }
}
