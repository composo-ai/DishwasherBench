{
  "name": "@spotless/integration",
  "version": "0.1.0",
  "private": true,
  "description": "Integration tests of the loading chain: catalogue items through the geometry kernel into the physics world, on a stand-in rack",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dump-scene": "tsx scripts/dump-scene.ts",
    "step-times": "tsx scripts/step-times.ts"
  },
  "dependencies": {
    "@spotless/catalogue": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/physics": "workspace:*"
  },
  "devDependencies": {
    "@spotless/levels": "workspace:*",
    "@spotless/loader": "workspace:*",
    "@spotless/machine": "workspace:*",
    "@spotless/session": "workspace:*"
  }
}
