{
  "name": "@spotless/server",
  "version": "0.1.0",
  "private": true,
  "description": "spotless-simd: HTTP + WebSocket API, wash job queue, result cache and CLI",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./slot-advice": "./src/slot-advice.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "serve": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.3",
    "@spotless/catalogue": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/inspector": "workspace:*",
    "@spotless/levels": "workspace:*",
    "@spotless/machine": "workspace:*",
    "@spotless/physics": "workspace:*",
    "@spotless/render": "workspace:*",
    "@spotless/session": "workspace:*",
    "@spotless/wash-runner": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "bin": {
    "spotless-simd": "./src/cli.ts"
  }
}
