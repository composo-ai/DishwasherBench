{
  "name": "@spotless/sim-scene",
  "version": "0.1.0",
  "private": true,
  "description": "Wash simulation module M3: atlas, ray primitives and queries, cell graph and placement analysis",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench:full-load": "tsx bench/full-load.ts",
    "check:catalogue": "tsx bench/catalogue-check.ts",
    "check:review": "tsx bench/review-check.ts"
  },
  "dependencies": {
    "@spotless/core": "workspace:*",
    "@spotless/geometry": "workspace:*",
    "@spotless/machine": "workspace:*",
    "@spotless/sim-gpu": "workspace:*",
    "@spotless/sim-params": "workspace:*"
  }
}
