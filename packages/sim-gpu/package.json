{
  "name": "@spotless/sim-gpu",
  "version": "0.1.0",
  "private": true,
  "description": "Wash simulation module M1: GPU compute foundation (WebGPU through the Dawn Node bindings), buffers, kernels, record layouts, reductions and provenance",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "record-probes": "tsx scripts/record-probes.ts",
    "soak": "tsx scripts/soak.ts",
    "bench:stencil": "tsx bench/stencil.ts",
    "bench:reduce": "tsx bench/reduce.ts"
  },
  "dependencies": {
    "@spotless/core": "workspace:*",
    "webgpu": "0.6.2"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74"
  }
}
