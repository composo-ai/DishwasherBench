# Local settings for model runs of the Spotless benchmark (DishwasherBench). Copy this file to
# .env (which git ignores) and fill in. The command line of the harness (packages/bench) loads
# .env when it starts; a variable already set in the environment wins. Never commit a key, and
# leave every value in this example file empty: the hygiene check fails on a filled-in one.
# Nothing here is needed to play, to wash a saved load or to run a scripted player.

# An OpenAI-compatible endpoint (policies openai:<model or deployment>).
# For Azure: https://<resource>.services.ai.azure.com/openai/v1 and the names of the deployments.
SPOTLESS_OPENAI_BASE_URL=
SPOTLESS_OPENAI_API_KEY=
# Optional. Two models or deployments by name: the one you use for trying things out, and a
# dearer one for a few runs on finished levels. The harness does not read them (the model that
# plays is named in the policy on the command line); the cost script, below, prices both.
SPOTLESS_OPENAI_MODEL_ITERATE=
SPOTLESS_OPENAI_MODEL_EXPENSIVE=

# Optional. The header the key is sent in: api-key (Azure; the default for a host under
# azure.com) or authorization (Bearer; the default otherwise).
SPOTLESS_OPENAI_AUTH_HEADER=
# Optional. reasoning_effort of every request; left empty, the model's own default holds.
SPOTLESS_OPENAI_REASONING_EFFORT=
# Optional. Prices in US dollars per million tokens; without input and output prices no cost is recorded.
# These hold for any model that has no prices of its own.
SPOTLESS_OPENAI_PRICE_INPUT=
SPOTLESS_OPENAI_PRICE_CACHED_INPUT=
SPOTLESS_OPENAI_PRICE_OUTPUT=
# Prices of one deployment: its name in capitals with every other character as an underscore
# (gpt-6.1-sol is GPT_6_1_SOL). The harness records cost with them, and the cost script
# (pnpm --filter @spotless/bench episode-cost) prices both models named above.
# SPOTLESS_OPENAI_PRICE_GPT_6_1_SOL_INPUT=
# SPOTLESS_OPENAI_PRICE_GPT_6_1_SOL_CACHED_INPUT=
# SPOTLESS_OPENAI_PRICE_GPT_6_1_SOL_OUTPUT=

# Anthropic's API (policies anthropic:<model id>). This path has not been run against the live API.
ANTHROPIC_API_KEY=
